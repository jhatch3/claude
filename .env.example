# Copy the values you need into .env (which is gitignored). The app reads these
# at startup via load_dotenv() in app.py / main.py.

# Anthropic API key (required for the model calls)
ANTHROPIC_API_KEY=sk-ant-...

# Redis via Upstash REST (HTTPS). Copy both from the Upstash console "REST API"
# section. The app also accepts the REST URL under REDIS_URL as a fallback.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest-token>
